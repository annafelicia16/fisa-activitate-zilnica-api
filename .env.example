
# Environment
ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=.Development

# Master Database Connection (SQL Server in Docker)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=1433
MASTER_DB_DATABASE=fisa_activitate_zilnica
MASTER_DB_USERNAME=sa
MASTER_DB_PASSWORD=YourStrong!Passw0rd
MASTER_DB_FORWARD_PORT=1433

# Database Connection
UNIVERSITY_DB_HOST=
UNIVERSITY_DB_DATABASE=
UNIVERSITY_DB_USERNAME=
UNIVERSITY_DB_PASSWORD=
UNIVERSITY_DB_ROOT_PASSWORD=${UNIVERSITY_DB_PASSWORD}
UNIVERSITY_DB_FORWARD_PORT=3307

# API Port
API_PORT=8000

# Client URL (origin allowed by CORS)
CLIENT_URL=http://localhost:5173

# File storage (daily activity record attachments). Defaults to ./FileStorage
# when unset; in Docker point this at a mounted volume.
# FILE_STORAGE_PATH=./FileStorage
